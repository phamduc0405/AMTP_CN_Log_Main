<UserControl
    x:Class="MTP.Views.Home.EquipmentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MTP.Views.Home"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Border
            Margin="5,5"
            Background="White"
            BorderBrush="Black"
            BorderThickness="0.5"
            CornerRadius="5">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Height="50"
                    Margin="3"
                    Background="#FF7FA6EF"
                    CornerRadius="3">
                    <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                            x:Name="txtHeader"
                            Margin="20,0,20,0"
                            HorizontalAlignment="Center"
                            Foreground="Black"
                            Style="{StaticResource HeaderTextBlockStyle}"
                            Text="EQUIPMENT" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                      Margin="2,0,0,0">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TOTAL:"
                                                       FontSize="15" TextAlignment="Center"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       Margin="0">
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                                       Margin="0"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       x:Name="txtCountTotalEquip"
                                                       Text="0" TextAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="Black"></TextBlock>

                            </Grid>
                            <Grid Grid.Column="1"
                                      Margin="0,0,0,0">
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock  FontSize="15"
                                                        Margin="0"
                                                        Style="{StaticResource HeaderTextBlockStyle}"
                                                        Text="OK" TextAlignment="Center"
                                                        FontWeight="Bold"
                                                        Foreground="Green">
                                    </TextBlock>

                                    <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       FontSize="15"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       x:Name="txtCountOKEquip"
                                                       Text="0" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Green"></TextBlock>
                                    <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       FontSize="15"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       x:Name="txtOKPercentEquip"
                                                       Text="(0%)" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Green"></TextBlock>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="2"
                                      Margin="5,0,5,0">
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                        <TextBlock FontSize="15"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       Text="NG" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Red"/>
                                        <TextBlock FontSize="15"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       Text="CNT" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Red"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       FontSize="15"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       x:Name="txtCountNGEquip"
                                                       Text="0" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Red"></TextBlock>
                                    <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       FontSize="15"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       x:Name="txtNGPercentEquip"
                                                       Text="(0%)" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Red"></TextBlock>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="3"
                                      Margin="5,0,5,0">
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                        <TextBlock FontSize="15"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       Text="NG" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Red"/>
                                        <TextBlock FontSize="15"
                                                       Style="{StaticResource HeaderTextBlockStyle}"
                                                       Text="INS" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Red"/>
                                    </StackPanel>
                                   
                                    <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       FontSize="15"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       x:Name="txtCountNGInsEquip"
                                                       Text="0" TextAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="Red"></TextBlock>
                                    <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       FontSize="15" TextAlignment="Center"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       x:Name="txtNGInsPercentEquip"
                                                       Text="(0%)" 
                                                       FontWeight="Bold"
                                                       Foreground="Red"></TextBlock>
                                </Grid>
                            </Grid>
                        </Grid>
                        </Grid>
                        

                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel Name="stkMain" Orientation="Horizontal" />

                </ScrollViewer>

                <Border
                    x:Name="brdMes"
                    Grid.Row="1"
                    Height="auto"
                    Margin="2"
                    Background="Red"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        x:Name="txtStatus"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White" />
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
